{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mhxy-budget-planner:input:1.0",
  "title": "手工装备预算比较输入",
  "description": "结构约定；动态指标键、引用与唯一性、矛盾限制、六位小数原始标记和资源上限由 Python/浏览器引擎强制检查。null 可存为未完成草稿，但不满足本计算输入 Schema。不会联网加载。",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "budget": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000,
      "multipleOf": 1e-06
    },
    "currency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "direction": {
            "enum": [
              "maximize",
              "minimize"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "unit",
          "direction"
        ],
        "additionalProperties": false
      }
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 12,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1000000000000,
        "multipleOf": 1e-06
      },
      "description": "仅 weighted 模式必填；如提供必须完整覆盖 metrics，全部非负且至少一项大于零。非加权目标不使用它评分或打破平局。"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "stats": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 12,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "number",
            "minimum": -1000000000000,
            "maximum": 1000000000000,
            "multipleOf": 1e-06
          },
          "description": "键必须恰好覆盖 metrics 的 ID；动态键一致性由计算器强制验证。"
        },
        "equipment": {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "evidence": {
          "enum": [
            "user_confirmed",
            "unverified",
            "synthetic"
          ]
        }
      },
      "required": [
        "label",
        "stats"
      ],
      "additionalProperties": false
    },
    "options": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000,
            "multipleOf": 1e-06
          },
          "deltas": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 12,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            },
            "additionalProperties": {
              "type": "number",
              "minimum": -1000000000000,
              "maximum": 1000000000000,
              "multipleOf": 1e-06
            },
            "description": "键必须恰好覆盖 metrics 的 ID；动态键一致性由计算器强制验证。"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "measured_stats": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 12,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            },
            "additionalProperties": {
              "type": "number",
              "minimum": -1000000000000,
              "maximum": 1000000000000,
              "multipleOf": 1e-06
            },
            "description": "键必须恰好覆盖 metrics 的 ID；动态键一致性由计算器强制验证。"
          },
          "fees": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000,
            "multipleOf": 1e-06
          },
          "owned": {
            "type": "boolean"
          },
          "evidence": {
            "enum": [
              "user_confirmed",
              "unverified",
              "synthetic"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "name",
          "slot",
          "price"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "deltas"
            ],
            "not": {
              "required": [
                "measured_stats"
              ]
            }
          },
          {
            "required": [
              "measured_stats"
            ],
            "not": {
              "required": [
                "deltas"
              ]
            }
          }
        ]
      }
    },
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 10
    },
    "constraints": {
      "type": "object",
      "properties": {
        "min_stats": {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "number",
            "minimum": -1000000000000,
            "maximum": 1000000000000,
            "multipleOf": 1e-06
          }
        },
        "max_stats": {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "number",
            "minimum": -1000000000000,
            "maximum": 1000000000000,
            "multipleOf": 1e-06
          }
        },
        "locked_slots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "maxItems": 12,
          "uniqueItems": true
        },
        "required_options": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "excluded_options": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            },
            "maxItems": 2,
            "uniqueItems": true,
            "minItems": 2
          },
          "maxItems": 128
        },
        "max_changes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "school": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "server": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "budget_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "budget": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000,
            "multipleOf": 1e-06
          }
        },
        "required": [
          "label",
          "budget"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    },
    "weight_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "weights": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 12,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000,
              "multipleOf": 1e-06
            },
            "description": "键必须恰好覆盖 metrics 的 ID；动态键一致性由计算器强制验证。"
          }
        },
        "required": [
          "label",
          "weights"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    },
    "manual_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "option_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            },
            "maxItems": 12,
            "uniqueItems": true
          }
        },
        "required": [
          "label",
          "option_ids"
        ],
        "additionalProperties": false
      },
      "maxItems": 2
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "confirmed",
              "unverified",
              "not_applicable"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "item",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "objective": {
      "enum": [
        "weighted",
        "min_cost",
        "pareto"
      ],
      "description": "选择比较目标。省略时：存在 weights 使用兼容旧版 weighted；无 weights 使用 pareto。min_cost 与 pareto 不需要权重。"
    }
  },
  "required": [
    "schema_version",
    "budget",
    "currency",
    "metrics",
    "baseline",
    "options"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "objective": {
            "const": "weighted"
          }
        },
        "required": [
          "objective"
        ]
      },
      "then": {
        "required": [
          "weights"
        ]
      }
    }
  ]
}
